{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "CMake: Configure",
      "command": "cmake",
      "args": ["-B", "build", "-S", ".", "-G", "MinGW Makefiles"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "CMake: Build",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Release"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "CMake: Configure",
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "shell",
      "label": "Run Adventure Game",
      "command": "${workspaceFolder}\\Adventure-Game\\adventure_game.exe",
      "group": "build",
      "problemMatcher": []
    }
  ]
}