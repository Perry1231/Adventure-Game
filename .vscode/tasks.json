{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Adventure Game",
      "command": "g++",
      "args": [
        "Main.cpp",
        "Character.cpp",
        "MainFunction.cpp",
        "Inventory.cpp",
        "Weapon.cpp",
        "Potion.cpp",
        "Armory.cpp",
        "Action.cpp",
        "Plot.cpp",
        "Trade.cpp",
        "Addition.cpp",
        "OtherCharacter.cpp",
        "OtherRandomizer.cpp",
        "Chest.cpp",
        "Evets.cpp",
        "-static-libgcc",
        "-static-libstdc++",
        "-static",
        "-o",
        "AdventureGame.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}