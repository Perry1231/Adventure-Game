{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "Build Adventure Game",
      "command": "g++",
      "args": [
        "-Wall",
        "-Wextra",
        "-g3",
        "-std=c++17",
        "${workspaceFolder}\\*.cpp",
        "-o",
        "${workspaceFolder}\\output\\Main.exe"
      ],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compile all .cpp files in the project root"
    }
  ]
}
