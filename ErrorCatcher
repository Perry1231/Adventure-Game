#include "Header.h"
#include <iostream>
#include <fstream>
#include <stdexcept> 

void All_Error_Detector_Check(std::ofstream& fs)
{
Fail_To_Close_File(fs);
File_Is_Empty(fs);

}

void Fail_To_Close_File(std::ofstream& fs)
{
try
{
        if (!fs.is_open())
    {
            throw std::runtime_error("Error occurred! File is not open");
    }
}
catch(const std::runtime_error& error)
{
        std::cout << "Caught error! " << error.what() << std::endl;
}
}

void File_Is_Empty(std::ofstream& fs)
{
    if (fs.is_open())
{
        std::streampos currentPos = fs.tellp();
        fs.seekp(0, std::ios::end);

        if (fs.tellp() == 0)
        {
            std::cout << "Error: File is empty!" << std::endl;
    }
    
        fs.seekp(currentPos);
}
}



void Fail_To_Open_File(std::ofstream& fs)
{
    if (!fs.is_open()) {
        std::cout << "Error: failed to create save file!\n";
        throw std::runtime_error("Failed to open file");
    }

}


