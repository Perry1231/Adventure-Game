        case 1:
            Task_1_CollectThings();
            break;
        case 2:
            Task_2_Rescue();
            break;
        case 3:
            Task_3_Explore();
            break;
        case 4:
            Task_4_Eliminate();
            break;
        case 5:
            Task_5_Deliver();
            break;
        case 6:
            Task_6_Escort();
            break;
        case 7:
            Task_7_Puzzle();
            break;
        case 0:
